{
  "name": "@scriptgo/cli",
  "version": "0.1.7",
  "description": "The scriptgo command line: create, test, verify, pack, publish and install SCRIPT//GO resources.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://scriptgo.dev/docs/cli",
  "bugs": "https://github.com/scriptgo-hq/scriptgo-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scriptgo-hq/scriptgo-sdk.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "scriptgo",
    "lua",
    "scripting",
    "game-server",
    "mods",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scriptgo": "./bin/scriptgo.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "bin": {
      "scriptgo": "./dist/scriptgo.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@scriptgo/escrow": "workspace:*",
    "@scriptgo/manifest": "workspace:*",
    "@scriptgo/shared": "workspace:*",
    "@types/node": "^22.15.0",
    "fflate": "^0.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
