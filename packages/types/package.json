{
  "name": "@scriptgo/types",
  "version": "0.1.12",
  "description": "TypeScript declarations of the SCRIPT//GO runtime API, for scripts written in TypeScript.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://scriptgo.dev",
  "bugs": "https://github.com/scriptgo-hq/scriptgo-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scriptgo-hq/scriptgo-sdk.git",
    "directory": "packages/types"
  },
  "keywords": [
    "scriptgo",
    "lua",
    "scripting",
    "game-server",
    "mods"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/sample/tsconfig.json && tsc -p test/conformance/probe.tsconfig.json && tsc -p test/conformance/xlang.tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.15.0"
  }
}
