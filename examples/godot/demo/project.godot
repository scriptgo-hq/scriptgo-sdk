; SCRIPT//GO on Godot 4: a small project that runs the official packages (InventoryKit, EventBus,
; Permissions) through lua-gdextension. Run setup.ps1 once before opening it.

config_version=5

[application]

config/name="SCRIPT//GO Godot demo"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

ScriptGoWatchdog="*res://addons/scriptgo/scriptgo_watchdog.gd"
ScriptGoHost="*res://addons/scriptgo/scriptgo_host.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.956863, 0.937255, 0.894118, 1)
