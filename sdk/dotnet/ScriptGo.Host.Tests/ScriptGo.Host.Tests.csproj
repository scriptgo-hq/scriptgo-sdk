<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <Description>Tests of the SCRIPT//GO .NET host kit.</Description>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ScriptGo.Host/ScriptGo.Host.csproj" />
    <!-- Built with the tests and run as a process by EscrowExampleTests; not linked into them. -->
    <ProjectReference Include="../../examples/custom-adapter-dotnet/AcmeEngine.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The cross-language escrow vector, generated by packages/escrow/tools/gen-vectors.ts. -->
    <EmbeddedResource Include="Fixtures/escrow-vector.json" LogicalName="ScriptGo.Host.Tests.escrow-vector.json" />
    <!-- The asset vectors, generated by packages/escrow/tools/gen-asset-vectors.ts; read where they are written. -->
    <EmbeddedResource Include="../../../packages/escrow/test/vectors/asset-vectors.json" LogicalName="ScriptGo.Host.Tests.asset-vectors.json" />
  </ItemGroup>
</Project>
