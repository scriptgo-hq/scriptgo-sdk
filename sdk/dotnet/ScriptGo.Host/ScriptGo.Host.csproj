<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ScriptGo.Host</RootNamespace>
    <Description>The SCRIPT//GO host kit for .NET: resources, events, exports across languages, quotas, and Lua (KeraLua) and JavaScript (Jint) guests.</Description>
    <PackageId>ScriptGo.Host</PackageId>
    <PackageTags>scriptgo;lua;javascript;typescript;sandbox;game-server;modding</PackageTags>
    <!-- Placeholder until the owner states the SDK licence; see LEGAL_DEPENDENCIES.md. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU5124</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KeraLua" />
    <PackageReference Include="Jint" />
  </ItemGroup>
  <ItemGroup>
    <!-- Escrow (signed, encrypted releases) is its own package, usable without this sandbox. -->
    <ProjectReference Include="../ScriptGo.Escrow/ScriptGo.Escrow.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The guest preludes, and the portable core's JSON module (one implementation for every Lua host). -->
    <EmbeddedResource Include="Guests/Lua/prelude.lua" LogicalName="ScriptGo.Host.prelude.lua" />
    <EmbeddedResource Include="../../lua/scriptgo/json.lua" LogicalName="ScriptGo.Host.json.lua" />
    <EmbeddedResource Include="../../lua/scriptgo/compat.lua" LogicalName="ScriptGo.Host.compat.lua" />
    <EmbeddedResource Include="../../lua/scriptgo/perks.lua" LogicalName="ScriptGo.Host.perks.lua" />
    <EmbeddedResource Include="../../lua/scriptgo/presence.lua" LogicalName="ScriptGo.Host.presence.lua" />
    <EmbeddedResource Include="Guests/JavaScript/prelude.js" LogicalName="ScriptGo.Host.prelude.js" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ScriptGo.Host.Tests" />
  </ItemGroup>
</Project>
