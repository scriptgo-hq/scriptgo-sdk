<?xml version="1.0" encoding="UTF-8"?>
<!--
  scriptgo-jvm: runs the pure-Lua SCRIPT//GO core in Cobalt (a Lua 5.2 VM in Java) behind a small
  host interface (HostServices). Knows nothing about Hytale: the plugin module maps HostServices
  onto the Hytale server API. The core (sdk/lua/scriptgo) and the Hytale Lua side (../lua) are
  packaged as classpath resources, never copied into the source tree.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>scriptgo</groupId>
    <artifactId>scriptgo-hytale-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>scriptgo-jvm</artifactId>
  <name>SCRIPT//GO JVM bridge (Cobalt)</name>

  <dependencies>
    <dependency>
      <groupId>cc.tweaked</groupId>
      <artifactId>cobalt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/../../../lua/scriptgo</directory>
        <targetPath>scriptgo/core</targetPath>
        <includes><include>*.lua</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../lua</directory>
        <targetPath>scriptgo/hytale</targetPath>
        <includes><include>*.lua</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration><propertiesEncoding>UTF-8</propertiesEncoding></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Tests run the real conformance probe and packages from the repository. -->
            <scriptgo.repo>${project.basedir}/../../../..</scriptgo.repo>
            <cobalt.sha256>${cobalt.sha256}</cobalt.sha256>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
