<?xml version="1.0" encoding="UTF-8"?>
<!--
  SCRIPT//GO for Hytale: build of the JVM bridge and of the Hytale server plugin.

    ./mvnw -q verify
        the bridge (Cobalt + the pure-Lua core), tested on a plain JVM, and a compile check of the
        plugin against hand-written API stand-ins (api-stubs); that jar is not for servers
    ./mvnw -q package -Dhytale.server.jar=<HytaleServer.jar>
        the real plugin, compiled against the owner's server jar: plugin/target/scriptgo-hytale-0.1.0.jar
    ./mvnw -q package -Dhytale.version=0.7.6
        the same against com.hypixel.hytale:Server from maven.hytale.com

  The real plugin needs a JDK 25 to compile (the server's class files are Java 25); the rest builds
  with 21. The plugin's own classes target Java 21.
  Every version below is pinned; see LEGAL_DEPENDENCIES.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>scriptgo</groupId>
  <artifactId>scriptgo-hytale-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>SCRIPT//GO for Hytale</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Cobalt (cc.tweaked:cobalt), MIT. SHA-256 of the jar, checked by CobaltTest:
         aca9fe1a2cab3ea7e296a72a1a6f667e29ddfdbab7af7cee35420bc2cc6e6929 -->
    <cobalt.version>0.9.9</cobalt.version>
    <cobalt.sha256>aca9fe1a2cab3ea7e296a72a1a6f667e29ddfdbab7af7cee35420bc2cc6e6929</cobalt.sha256>
    <junit.version>6.1.3</junit.version>
  </properties>

  <modules>
    <module>bridge</module>
  </modules>

  <repositories>
    <!-- Cobalt is published only on the CC: Tweaked maven. -->
    <repository>
      <id>squiddev</id>
      <url>https://maven.squiddev.cc</url>
      <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cc.tweaked</groupId>
        <artifactId>cobalt</artifactId>
        <version>${cobalt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.16.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.6.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.5.1</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.2</version></plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Without a Hytale server API: compile the plugin against the stand-ins only. -->
    <profile>
      <id>hytale-stubs</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <modules><module>api-stubs</module><module>plugin</module></modules>
    </profile>
    <!-- The real plugin, against the owner's own server jar... -->
    <profile>
      <id>hytale-local</id>
      <activation><property><name>hytale.server.jar</name></property></activation>
      <modules><module>plugin</module></modules>
    </profile>
    <!-- ...or the artifact Hypixel publishes for modding projects (needs the owner's agreement to
         the Hytale EULA, which governs downloading it). -->
    <profile>
      <id>hytale-maven</id>
      <activation><property><name>hytale.version</name></property></activation>
      <modules><module>plugin</module></modules>
    </profile>
  </profiles>
</project>
