+using Open77.Resources.Model;
+
+namespace Open77.Server.Scripting.Hosting;
+
+/// <summary>Optional source of SCRIPT//GO escrowed resources. Implemented in a separate assembly
+/// that references the SCRIPT//GO .NET host (the decryptor); constructed by the composition root only
+/// when scripting.scriptgo.enabled is set. When null, OPEN//77 loads only disk resources, as today.
+/// The decrypted scripts stay in memory (PreparedResourceScripts), never on disk.</summary>
+public interface IEscrowResourceProvider
+{
+    /// <summary>Parsed sources for the escrowed resources this server is entitled to (no disk scan).
+    /// Each ResourceSource's manifest is the decrypted open77.lua; its scripts come from Prepare.</summary>
+    IReadOnlyList<ResourceSource> Discover();
+
+    /// <summary>In-memory decrypted scripts for an escrow-backed source, or null if it is not ours
+    /// (the caller then falls back to PreparedResourceScripts.ReadFromDisk).</summary>
+    PreparedResourceScripts? Prepare(ResourceSource source);
+}

